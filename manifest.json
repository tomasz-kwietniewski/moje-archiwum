{
  "manifest_version": 3,
  "name": "Moje archiwum - Markdown",
  "version": "0.4.6",
  "description": "Zapisz czytaną stronę jako plik Markdown z obrazami offline.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Zapisz stronę do Markdown"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Zapisz stronę do Markdown"
    }
  }
}
